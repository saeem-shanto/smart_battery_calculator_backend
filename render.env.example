# Production values for Render. Add these in Render > Service > Environment.
# Never commit real values to source control.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=<generate-a-long-random-secret>
ALLOWED_HOSTS=<your-render-hostname>

# Supabase PostgreSQL shared/session pooler connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=10

# Private Supabase Storage S3-compatible bucket.
SUPABASE_STORAGE_ENABLED=True
SUPABASE_STORAGE_BUCKET=smart-battery-files
SUPABASE_S3_ENDPOINT=<supabase-s3-endpoint>
SUPABASE_S3_REGION=<supabase-region>
SUPABASE_S3_ACCESS_KEY_ID=<s3-access-key>
SUPABASE_S3_SECRET_ACCESS_KEY=<s3-secret-key>
SUPABASE_S3_QUERYSTRING_EXPIRE=300

FRONTEND_URL=https://<your-frontend-host>
CORS_ALLOWED_ORIGINS=https://<your-frontend-host>
CSRF_TRUSTED_ORIGINS=https://<your-frontend-host>

# Brevo transactional email API over HTTPS (works on Render Free; no SMTP ports).
ACCOUNT_EMAIL_ENABLED=True
EMAIL_BACKEND=apps.common.email_backends.BrevoApiEmailBackend
BREVO_API_KEY=<brevo-v3-api-key>
BREVO_SENDER_EMAIL=<verified-sender-email>
BREVO_SENDER_NAME=Smart Battery Calculator
# Optional. Leave blank if you do not need replies.
BREVO_REPLY_TO_EMAIL=
BREVO_API_CONNECT_TIMEOUT=5
BREVO_API_READ_TIMEOUT=15
# Optional override; should contain the same verified sender email.
# DEFAULT_FROM_EMAIL=Smart Battery Calculator <verified-sender-email>

PASSWORD_RESET_TIMEOUT_SECONDS=3600
PASSWORD_RESET_RESEND_SECONDS=60
TWO_FACTOR_OTP_TTL_SECONDS=600
TWO_FACTOR_OTP_RESEND_SECONDS=60
TWO_FACTOR_OTP_MAX_ATTEMPTS=5

OCTAVE_EXECUTABLE=octave-cli
OCTAVE_TIMEOUT_SECONDS=300
OCTAVE_SERIALIZE_CALLS=True
OCTAVE_DIAGNOSTICS_ENABLED=False
REQUIRE_FULL_YEAR_PROFILE=True
PROFILE_UPLOAD_TTL_HOURS=24
PROFILE_UPLOAD_MAX_MB=15
PROFILE_AVATAR_MAX_MB=5
CALCULATION_RETENTION_DAYS=90

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
