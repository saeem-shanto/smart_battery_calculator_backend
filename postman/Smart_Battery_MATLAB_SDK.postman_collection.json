{
  "info": {
    "name": "Smart Battery Calculator - MATLAB Compiler SDK",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "MATLAB SDK Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/matlab-sdk/status/"
      }
    },
    {
      "name": "MATLAB SDK Direct Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pv_profile\": [0,0,0,0,0,0.05,0.15,0.35,0.55,0.75,0.9,1.0,0.95,0.85,0.7,0.5,0.3,0.12,0.03,0,0,0,0,0],\n  \"load_profile\": [0.35,0.3,0.28,0.26,0.3,0.4,0.55,0.6,0.5,0.4,0.35,0.3,0.32,0.35,0.4,0.5,0.75,1.1,1.3,1.0,0.8,0.65,0.5,0.4],\n  \"profile_is_base_pv\": true,\n  \"pv_size_kw\": 5,\n  \"battery_annual_cost_per_kwh\": 50,\n  \"battery_installed_cost_per_kwh\": 1000,\n  \"retail_price_per_kwh\": 0.3773,\n  \"feed_in_tariff_per_kwh\": 0.124,\n  \"max_battery_capacity_kwh\": 50\n}"
        },
        "url": "{{baseUrl}}/api/v1/matlab-sdk/test/"
      }
    },
    {
      "name": "MATLAB SDK Legacy File Test",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "pv_size_kw",
              "value": "5",
              "type": "text"
            },
            {
              "key": "battery_annual_cost_per_kwh",
              "value": "50",
              "type": "text"
            },
            {
              "key": "battery_installed_cost_per_kwh",
              "value": "1000",
              "type": "text"
            },
            {
              "key": "retail_price_per_kwh",
              "value": "0.3773",
              "type": "text"
            },
            {
              "key": "feed_in_tariff_per_kwh",
              "value": "0.124",
              "type": "text"
            },
            {
              "key": "max_battery_capacity_kwh",
              "value": "50",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/matlab-sdk/test-file/"
      }
    },
    {
      "name": "Production-style Client Workbook Calculation",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "consent",
              "value": "true",
              "type": "text"
            },
            {
              "key": "pv_size_kw",
              "value": "5",
              "type": "text"
            },
            {
              "key": "battery_annual_cost_per_kwh",
              "value": "50",
              "type": "text"
            },
            {
              "key": "battery_installed_cost_per_kwh",
              "value": "1000",
              "type": "text"
            },
            {
              "key": "retail_price_per_kwh",
              "value": "0.3773",
              "type": "text"
            },
            {
              "key": "feed_in_tariff_per_kwh",
              "value": "0.124",
              "type": "text"
            },
            {
              "key": "max_battery_capacity_kwh",
              "value": "50",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/calculations/client-workbook/"
      }
    }
  ]
}
