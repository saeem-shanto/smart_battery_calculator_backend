{
  "info": {
    "name": "Smart Battery Calculator - Production GNU Octave",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Production API checks for the Smart Battery Calculator. The calculation endpoint executes the client MATLAB source unchanged under GNU Octave. Input files are deduplicated by SHA-256 and each unique input has at most one canonical Results_RPAtrail400.csv."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "calculationPublicId",
      "value": ""
    },
    {
      "key": "calculationAccessToken",
      "value": ""
    },
    {
      "key": "inputFileId",
      "value": ""
    },
    {
      "key": "csvFileId",
      "value": ""
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminAccessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Production API checks",
      "description": "Run these in order against local development or the deployed Render service.",
      "item": [
        {
          "name": "API Liveness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Liveness returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Service reports ok\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "API Readiness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/ready/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Readiness returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Database and Octave are ready\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"ready\");",
                  "  pm.expect(body.database.ready).to.eql(true);",
                  "  pm.expect(body.engine.ready).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Production-style Client Workbook Calculation",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "consent",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "battery_installed_cost_per_kwh",
                  "value": "1000",
                  "type": "text"
                },
                {
                  "key": "postcode",
                  "value": "5000",
                  "type": "text"
                },
                {
                  "key": "suburb",
                  "value": "Adelaide",
                  "type": "text"
                },
                {
                  "key": "state",
                  "value": "SA",
                  "type": "text"
                },
                {
                  "key": "metadata",
                  "value": "{\"scenario_label\":\"Postman production check\",\"source\":\"manual-test\"}",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/calculations/client-workbook/",
            "description": "Attach the client workbook. Input bytes are deduplicated by SHA-256. Each unique input has one canonical Results_RPAtrail400.csv. The optional postcode/suburb/state/metadata fields are stored on the calculation record for admin table/search use."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Calculation created\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.postcode).to.eql(\"5000\");",
                  "  pm.expect(body.result.optimizer_success).to.eql(true);",
                  "  pm.expect(body.result.profile_is_full_year).to.eql(true);",
                  "  pm.expect(body.files).to.be.an(\"array\").that.has.lengthOf(2);",
                  "  const byKind = Object.fromEntries(body.files.map(f => [f.kind, f]));",
                  "  pm.expect(byKind).to.have.property(\"input_workbook\");",
                  "  pm.expect(byKind).to.have.property(\"legacy_csv\");",
                  "  pm.expect(byKind.legacy_csv.filename).to.eql(\"Results_RPAtrail400.csv\");",
                  "  pm.collectionVariables.set(\"calculationPublicId\", body.public_id);",
                  "  pm.collectionVariables.set(\"calculationAccessToken\", body.access_token);",
                  "  pm.collectionVariables.set(\"inputFileId\", byKind.input_workbook.id);",
                  "  pm.collectionVariables.set(\"csvFileId\", byKind.legacy_csv.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Re-upload Same Input (Dedup Check)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "consent",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "battery_installed_cost_per_kwh",
                  "value": "1000",
                  "type": "text"
                },
                {
                  "key": "postcode",
                  "value": "5000",
                  "type": "text"
                },
                {
                  "key": "suburb",
                  "value": "Adelaide",
                  "type": "text"
                },
                {
                  "key": "state",
                  "value": "SA",
                  "type": "text"
                },
                {
                  "key": "metadata",
                  "value": "{\"scenario_label\":\"Postman production check\",\"source\":\"manual-test\"}",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/calculations/client-workbook/",
            "description": "Attach the exact same workbook bytes used in the previous request. The API should create a new calculation audit record but reuse the same StoredInputFile and the same Results_RPAtrail400.csv IDs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Repeated calculation created\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const byKind = Object.fromEntries(body.files.map(f => [f.kind, f]));",
                  "  pm.expect(byKind.input_workbook.id).to.eql(pm.collectionVariables.get(\"inputFileId\"));",
                  "  pm.expect(byKind.legacy_csv.id).to.eql(pm.collectionVariables.get(\"csvFileId\"));",
                  "  pm.expect(body.runtime_ms).to.eql(0);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve Saved Calculation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Calculation-Token",
                "value": "{{calculationAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/calculations/{{calculationPublicId}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Saved calculation retrieved\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Access token is not echoed back\", function () { pm.expect(pm.response.json()).to.not.have.property(\"access_token\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List Calculation Files",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Calculation-Token",
                "value": "{{calculationAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/calculations/{{calculationPublicId}}/files/",
            "description": "Returns only the unique input artifact and its one canonical legacy CSV."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"File list returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Only input and canonical CSV are stored\", function () {",
                  "  const files = pm.response.json();",
                  "  pm.expect(files).to.have.lengthOf(2);",
                  "  pm.expect(files.map(f => f.kind)).to.include.members([\"input_workbook\", \"legacy_csv\"]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Download Original Input",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Calculation-Token",
                "value": "{{calculationAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/calculations/{{calculationPublicId}}/files/{{inputFileId}}/download/",
            "description": "Downloads the exact uploaded bytes using the original stored filename."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Original input downloads\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Input has content\", function () { pm.expect(pm.response.responseSize).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Download Legacy CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Calculation-Token",
                "value": "{{calculationAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/calculations/{{calculationPublicId}}/files/{{csvFileId}}/download/",
            "description": "Downloads the exact Results_RPAtrail400.csv emitted by the unchanged client MATLAB source."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Legacy CSV downloads\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"CSV content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/csv\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/auth/token/",
            "description": "Set adminUsername and adminPassword as collection variables before running this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin login succeeds\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"adminAccessToken\", pm.response.json().access); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Calculation List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/calculations/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin calculation list returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Admin records expose stored file metadata\", function () {",
                  "  const body = pm.response.json();",
                  "  const rows = Array.isArray(body) ? body : body.results;",
                  "  pm.expect(rows).to.be.an(\"array\");",
                  "  if (rows.length) pm.expect(rows[0]).to.have.property(\"files\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Calculation Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/calculations/{{calculationPublicId}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin calculation detail returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Admin sees input and canonical CSV\", function () { pm.expect(pm.response.json().files).to.have.lengthOf(2); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Download Legacy CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/calculations/{{calculationPublicId}}/files/{{csvFileId}}/download/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin can download legacy CSV\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Admin CSV download has content\", function () { pm.expect(pm.response.responseSize).to.be.above(0); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Destructive admin checks (optional)",
      "description": "Run manually after normal API checks. These requests deliberately delete shared input/CSV bytes or the record.",
      "item": [
        {
          "name": "Admin Delete Input File",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/calculations/{{calculationPublicId}}/files/{{inputFileId}}/",
            "description": "Deletes the stored input bytes globally. Calculation record(s) remain and the canonical CSV remains."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Input file deleted\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.expect(body.kind).to.eql(\"input_workbook\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Delete CSV File",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/calculations/{{calculationPublicId}}/files/{{csvFileId}}/",
            "description": "Deletes Results_RPAtrail400.csv globally. Calculation record(s) remain and the input file remains if it was not deleted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"CSV file deleted\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.expect(body.kind).to.eql(\"legacy_csv\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Delete Calculation Record",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/calculations/{{calculationPublicId}}/",
            "description": "Deletes only the selected calculation record. Stored files are managed independently."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Calculation record deleted\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Optional GNU Octave diagnostics",
      "description": "These routes exist only when OCTAVE_DIAGNOSTICS_ENABLED=True. They are disabled by default in production.",
      "item": [
        {
          "name": "GNU Octave Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/octave/status/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Octave status returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Octave runtime is ready\", function () { pm.expect(pm.response.json().runtime_ready).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GNU Octave Direct Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pv_profile\": [\n    0,\n    0,\n    0,\n    0,\n    0,\n    0.05,\n    0.15,\n    0.35,\n    0.55,\n    0.75,\n    0.9,\n    1.0,\n    0.95,\n    0.85,\n    0.7,\n    0.5,\n    0.3,\n    0.12,\n    0.03,\n    0,\n    0,\n    0,\n    0,\n    0\n  ],\n  \"load_profile\": [\n    0.35,\n    0.3,\n    0.28,\n    0.26,\n    0.3,\n    0.4,\n    0.55,\n    0.6,\n    0.5,\n    0.4,\n    0.35,\n    0.3,\n    0.32,\n    0.35,\n    0.4,\n    0.5,\n    0.75,\n    1.1,\n    1.3,\n    1.0,\n    0.8,\n    0.65,\n    0.5,\n    0.4\n  ],\n  \"battery_installed_cost_per_kwh\": 1000\n}"
            },
            "url": "{{baseUrl}}/api/v1/octave/test/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Direct diagnostic succeeds\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Optimizer succeeds\", function () { pm.expect(pm.response.json().result.optimizer_success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GNU Octave Legacy File Test",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "battery_installed_cost_per_kwh",
                  "value": "1000",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/octave/test-file/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Workbook diagnostic succeeds\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Workbook contains a full-year result\", function () { pm.expect(pm.response.json().result.profile_is_full_year).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}