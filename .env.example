# -----------------------------------------------------------------------------
# Django environment
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///db.sqlite3

# For explicit commands you can set:
# DJANGO_SETTINGS_MODULE=config.settings.development
# Production: config.settings.production

# -----------------------------------------------------------------------------
# Production security (optional until HTTPS is configured)
# -----------------------------------------------------------------------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# -----------------------------------------------------------------------------
# Calculation engine
# reference_python | matlab_http
# -----------------------------------------------------------------------------
CALCULATION_ENGINE=reference_python
MATLAB_ENGINE_URL=http://localhost:8081/calculate
MATLAB_ENGINE_TIMEOUT_SECONDS=90

PROFILE_UPLOAD_TTL_HOURS=24
PROFILE_UPLOAD_MAX_MB=15

# Only used by the optional bootstrap_admin command.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
