# Local development template. Copy to .env and edit as needed.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=local-dev-only-change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use local SQLite, or provide PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=10

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Local email: messages print to the terminal and need no API key.
ACCOUNT_EMAIL_ENABLED=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Smart Battery Calculator <local@example.com>
# To test Resend locally instead, use:
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=re_your_key
# DEFAULT_FROM_EMAIL=Smart Battery Calculator <onboarding@resend.dev>
EMAIL_API_CONNECT_TIMEOUT=5
EMAIL_API_READ_TIMEOUT=15
PASSWORD_RESET_TIMEOUT_SECONDS=3600
TWO_FACTOR_OTP_TTL_SECONDS=600
TWO_FACTOR_OTP_RESEND_SECONDS=60
TWO_FACTOR_OTP_MAX_ATTEMPTS=5

# Local storage defaults to the filesystem. Enable only when testing Supabase Storage.
SUPABASE_STORAGE_ENABLED=False
SUPABASE_STORAGE_BUCKET=smart-battery-files
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_QUERYSTRING_EXPIRE=300

OCTAVE_EXECUTABLE=octave-cli
OCTAVE_TIMEOUT_SECONDS=120
OCTAVE_SERIALIZE_CALLS=True
OCTAVE_DIAGNOSTICS_ENABLED=True
REQUIRE_FULL_YEAR_PROFILE=False
PROFILE_UPLOAD_TTL_HOURS=24
PROFILE_UPLOAD_MAX_MB=15
PROFILE_AVATAR_MAX_MB=5
CALCULATION_RETENTION_DAYS=90
