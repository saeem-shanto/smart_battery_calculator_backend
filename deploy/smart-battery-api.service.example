[Unit]
Description=Smart Battery Calculator Django API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/smart-battery/backend
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
EnvironmentFile=/srv/smart-battery/backend/.env
ExecStartPre=/srv/smart-battery/backend/.venv/bin/python manage.py migrate --noinput
ExecStartPre=/srv/smart-battery/backend/.venv/bin/python manage.py collectstatic --noinput
ExecStart=/srv/smart-battery/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120 --access-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
